# Copy to .env and change secrets before going live.
# Data survives `docker compose down` (never use -v) in ./data/postgres and ./data/silo.

HTTP_PORT=8080

POSTGRES_USER=kryivka
POSTGRES_PASSWORD=kryivka
POSTGRES_DB=kryivka

DATABASE_URL=postgres://kryivka:kryivka@postgres:5432/kryivka
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRED_IN=60m
JWT_MAXAGE=60

STORAGE_TYPE=s3
S3_ENDPOINT=http://silo:9000
S3_BUCKET_NAME=kryivka
S3_ACCESS_KEY=kryivka
S3_SECRET_KEY=kryivka-silo-change-me
S3_PUBLIC_URL=http://localhost:8080/media

SERVE_FRONTEND=false
# FRONTEND_MODE: leave VITE_API_ORIGIN empty for same-origin (nginx). For CDN:
# VITE_API_ORIGIN=https://kryivka.org
# CORS_ORIGIN=https://cdn.example.com

ADMIN_BOOTSTRAP_USER=admin
# Super-admin username is always `admin`; this env is ignored if set to anything else.
# Password: 13+ chars, upper+lower, 2+ digits, 1+ special (2 preferred); no 123456/qwerty-style sequences.
ADMIN_BOOTSTRAP_KEY=ChangeThis-Staff12!
THREAD_AGE_LIMIT_DAYS=30
PURGE_INTERVAL_SECS=600
RATE_LIMIT_SECS=60

# Cookie Secure flag. Leave unset for local HTTP. Cloudflare Tunnel sets
# X-Forwarded-Proto=https so cookies become Secure automatically.
# COOKIE_SECURE=true

# Cloudflare Tunnel (compose --profile tunnel up)
# CLOUDFLARE_TUNNEL_TOKEN=

# SPA on CDN: build with VITE_API_ORIGIN=https://kryivka.org, FRONTEND_MODE=cdn,
# and set CORS_ORIGIN to the Pages/R2 origin.
# VITE_API_ORIGIN=
# FRONTEND_MODE=standalone
# CORS_ORIGIN=
